# Supabase (projeto sa-east-1) — Settings → API. A SERVICE KEY só existe no
# servidor (funções/dev server); nada disso é exposto ao navegador.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave do link do staff (#/validar?t=...) — invente um valor longo e aleatório.
LEADS_STAFF_TOKEN=

# Chave do export do comercial (GET /api/leads, header X-Admin-Token).
LEADS_ADMIN_TOKEN=

# Sem SUPABASE_* preenchidos, o dev server local roda com store em MEMÓRIA
# (zera a cada restart — só para desenvolver a conversa).
